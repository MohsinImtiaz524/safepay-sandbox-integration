# Safepay Sandbox credentials. These are server-only: never use NEXT_PUBLIC_.
SAFEPAY_API_KEY=sec_your_sandbox_api_key
# Private API secret used by @sfpy/node-core server requests.
SAFEPAY_SECRET_KEY=your_sandbox_server_secret_key
SAFEPAY_WEBHOOK_SECRET=your_sandbox_webhook_secret

# Use an HTTPS tunnel when Safepay must reach callbacks on your local machine.
APP_BASE_URL=http://localhost:3000
